PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key-here

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Firebase Admin SDK (for push notifications)
# Local dev: path to JSON key file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Production (Render/Railway): paste full JSON as one line into env var instead
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Stripe (Billing)
# Test keys from Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_PRICE_ID=price_replace-me
# From Stripe Dashboard → Developers → Webhooks → your endpoint → "Signing secret"
STRIPE_WEBHOOK_SECRET=whsec_replace-me
# URL the app deep-links back to after Checkout completes (success and cancel).
# In dev these can be http://localhost; in prod use your real deep link.
STRIPE_SUCCESS_URL=lottoclose://billing/success
STRIPE_CANCEL_URL=lottoclose://billing/cancel
